{
  "name": "specflow-repo",
  "private": true,
  "description": "Monorepo for @ceatoleii/specflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceatoleii/specflow.git"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @ceatoleii/specflow",
    "test": "npm run test -w @ceatoleii/specflow",
    "test:coverage": "npm run test:coverage -w @ceatoleii/specflow",
    "specflow": "npm run build -w @ceatoleii/specflow && node packages/specflow/dist/cli.js"
  }
}
